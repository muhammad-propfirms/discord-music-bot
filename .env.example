# Copy this file to ".env" and fill it in. Never share or commit .env!

# REQUIRED: your bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
TOKEN=

# Optional: your server ID(s), comma separated. Slash commands get registered there.
# Leave empty to register in every server the bot is in.
GUILD_ID=

# Optional: only these users / roles may use the bot (comma separated IDs). Empty = everyone.
ALLOWED_USER_IDS=
ALLOWED_ROLE_IDS=

# Starting volume for a new queue (0-100)
DEFAULT_VOLUME=50
# Max songs loaded from one playlist link
MAX_PLAYLIST_SIZE=100
# Seconds before leaving when everyone left the voice channel (0 = never)
LEAVE_WHEN_ALONE_AFTER=60
# Seconds before leaving after the queue finished (0 = never)
LEAVE_WHEN_IDLE_AFTER=300

# Optional: YouTube cookies (only if YouTube says "Sign in to confirm you're not a bot")
# Path to a Netscape-format cookies.txt file:
YTDLP_COOKIES=
# ...or the same file base64-encoded into one line:
YTDLP_COOKIES_BASE64=

# Optional advanced settings
# EXTRA_ALLOWED_HOSTS=   # extra domains /play may load links from, comma separated (e.g. example.com)
# YTDLP_PATH=          # use your own yt-dlp binary instead of the auto-downloaded one
# YTDLP_AUTO_UPDATE=true
# FFMPEG_PATH=         # use your own ffmpeg instead of the bundled one
# PORT=                # start a /healthz web server on this port (Render sets this for you)
# DEBUG_DISTUBE=false
